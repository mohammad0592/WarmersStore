# Copy to .env (never commit .env). Production values are set as Railway service variables.

# Database: either a full Npgsql connection string...
ConnectionStrings__Default=Host=localhost;Port=5433;Database=warmers;Username=warmers;Password=warmers_dev
# ...or a postgres:// URL (Railway: reference ${{Postgres.DATABASE_URL}}).
# DATABASE_URL=postgresql://user:password@host:5432/railway

ASPNETCORE_ENVIRONMENT=Development
# PORT is set automatically by Railway; the app listens on it when present.

# First admin account, created on startup only while no admin exists (then ignored).
# Locally prefer `dotnet user-secrets` (see README). At least 12 characters.
# Admin__Email=you@example.com
# Admin__Password=
